---
// "Set up Sidecar": the whole setup on one page, seven steps with a bench scene (a laptop, the Rytm, a Pi, an SD card).
// The user moves with Back / Next or the step rail: no autoplay. Each step does its job here: the patcher is the site's
// own page (public/patcher) in a frame, the config editor is src/components/ConfigEditor.astro, the downloads are the
// GitHub release assets named by RELEASE below (fill at release: see the UNRELEASED mark in the page that uses this).
// Styled with the tokens of the Pi's new web UI (web-next: "UV night"), scoped to .sg so the rest of the site is
// unchanged. Fonts (Space Grotesk, Doto; SIL OFL 1.1, notices in public/fonts/) are bundled from src/assets/fonts.
import ConfigEditor from './ConfigEditor.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const RELEASE = {
  repo: 'https://github.com/trigcondition/sidecar-firmware/releases',
  tag: 'v0.5.1',
  version: '0.5.1',
};
const image = (res: string) => `sidecar-${RELEASE.version}-sd-${res}.img.zip`;
const imageUrl = (res: string) => `${RELEASE.repo}/download/${RELEASE.tag}/${image(res)}`;
const releasePage = `${RELEASE.repo}/tag/${RELEASE.tag}`;
const SIZES = [
  { res: '800x480', title: '800x480', note: 'An 800x480 HDMI touch display (such as the 5" and 7" ones), a DSI display, or no display.' },
  { res: '1024x600', title: '1024x600', note: 'A 1024x600 HDMI display, such as the GeeekPi 7" (EP-0194).' },
];
const STEPS = [
  { t: 'What you need', s: 'The parts and tools, as a checklist.', d: 'Lay out the parts: a Raspberry Pi 4B or Pi 5, a microSD card, the official power supply, a heatsink or fan, a short USB A-to-B cable, and a display if you want one. Tick them off as you go.' },
  { t: 'Back up and get the stock OS', s: 'Back up with Transfer, then get Elektron\'s OS 1.74.', d: 'Back up your projects, kits, sounds and samples with Transfer. Then download Analog-Rytm_MKII_OS1.74 from Elektron\'s Rytm MKII support page and unzip it.' },
  { t: 'Patch it in your browser', s: 'Drop the stock file on the patcher.', d: 'Drop the stock .syx on the patcher, press Patch, then Save .syx. Everything happens in your browser; nothing is uploaded.' },
  { t: 'Flash the Rytm', s: 'Send the patched file with Transfer.', d: 'Connect the Rytm to your computer over USB and drop the patched file on Transfer. Confirm on the Rytm. If it stays on "Success! Rebooting", switch it off and on.' },
  { t: 'Make the SD card', s: 'Write the image for your screen.', d: 'In Raspberry Pi Imager: choose your Pi, then Use custom and the Sidecar image for your screen size, then the SD card. Answer No to customisation. Need Wi-Fi or another setting? Use the card config editor.' },
  { t: 'Connect', s: 'Card in the Pi, USB to the Rytm.', d: 'Put the card in the Pi. Connect the Rytm\'s USB port to a USB-A port on the Pi, with no hub. On the Rytm, set SETTINGS > SYSTEM > USB CONFIG to Overbridge.' },
  { t: 'Power up and play', s: 'Power the Pi. Pick an EXT machine.', d: 'Power the Pi with its official supply. After about 11 seconds the Rytm shows the Sidecar screen. Pick an EXT machine on a track and play. Hold UP to see every shortcut, and open sidecar.local for the web page.' },
];
const docs = (p: string) => `${base}/${p}`;
---

<div class="sg not-content" id="sg" data-steps={STEPS.length} data-step-text={JSON.stringify(STEPS.map((s) => ({ t: s.t, d: s.d })))}>
  <header class="sg-head">
    <p class="sg-label">Sidecar 0.5.1 · Analog Rytm MKII + Raspberry Pi 4B / 5</p>
    <p class="sg-title">Set up Sidecar in seven steps</p>
    <p class="sg-sub">From a stock Rytm to playing Sidecar machines: patch and flash the Rytm, write the Pi's SD card, connect, play. Prefer text? <a href={docs('getting-started/start-here/')}>Start here</a> has the same steps.</p>
  </header>

  <div class="sg-main">
    <ol class="sg-rail" id="sg-rail" aria-label="Setup steps">
      {STEPS.map((s, i) => (
        <li>
          <button type="button" class="sg-step" data-n={i + 1} id={`sg-step-${i + 1}`} aria-controls={`sg-panel-${i + 1}`}>
            <span class="sg-n">{i + 1}</span>
            <span class="sg-t">{s.t}</span>
            <span class="sg-d">{s.s}</span>
          </button>
        </li>
